  "narrative": {
    "northStar": "Shared training log",
    "overview": "A quiet, warm workspace makes a daily checklist and shared accountability ledger easy to scan. Forest green marks action and completion; terracotta explains fines and misses. Compact operational typography and simple bordered surfaces keep the task close.",
    "keyCharacteristics": [
      "Fast, reversible daily check-ins.",
      "Explicit states and traceable money.",
      "Shared React Native primitives, with Expo web as the shipping target."
    ],
    "rules": [
      {
        "name": "The Labeled State Rule",
        "body": "Every goal choice retains its Done or Missed label; an unset choice remains Pending. Color supports the label.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal backgrounds to separate surfaces; no shadows are shipped.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep check-in controls early on mobile and interactive targets at least 44px.",
      "Do retain text labels, selected semantics and visible keyboard focus alongside color.",
      "Do label synthetic demo data and manually recorded, unverified payments explicitly."
    ],
    "donts": [
      "Don't add decorative gradients, glass or stock fitness photography.",
      "Don't imply a payment transfers money or has been verified.",
      "Don't mix local demo records with authenticated shared data."
    ]
